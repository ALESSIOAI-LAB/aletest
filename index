<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DocuBot - Gestione Documenti</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
       .gradient { background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); }
</style>
</head>
<body class="gradient min-h-screen flex items-center justify-center p-4">
<div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full text-center">
<div class="text-6xl mb-4">📄</div>
<h1 class="text-3xl font-bold text-gray-800 mb-2">DocuBot</h1>
<p class="text-gray-600 mb-6">I tuoi documenti organizzati automaticamente</p>
<div class="space-y-4">
<div class="bg-green-50 p-4 rounded-lg">
<p class="text-sm text-green-800">📱 Scansiona documenti con WhatsApp</p>
</div>
<input type="tel" id="telefono" placeholder="Il tuo numero (339xxxxxxx)"
                  class="w-full p-3 border rounded-lg text-center">
<button onclick="entra()"
                   class="w-full bg-green-600 text-white py-3 rounded-lg font-bold hover:bg-green-700">
               Accedi ai miei documenti
</button>
</div>
<p class="mt-6 text-xs text-gray-500">
           Non hai un account? <a href="https://wa.me/TUONUMERO?text=Ciao%20voglio%20registrarmi" class="text-green-600">Scrivici su WhatsApp</a>
</p>
</div>
<script>
       function entra() {
           const tel = document.getElementById('telefono').value;
           if(tel.length < 10) {
               alert('Inserisci numero valido');
               return;
           }
           // Salva in localStorage per comodità
           localStorage.setItem('doctel', tel);
           location.href = 'archivio.html?tel=' + tel;
       }
       // Se già loggato, redirect
       if(localStorage.getItem('doctel')) {
           location.href = 'archivio.html?tel=' + localStorage.getItem('doctel');
       }
</script>
</body>
</html>
