<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Documento - DocuBot</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
<div id="loading" class="flex items-center justify-center h-screen">
<div class="text-center">
<div class="text-4xl mb-2">📄</div>
<p class="text-gray-600">Caricamento...</p>
</div>
</div>
<div id="content" class="hidden max-w-md mx-auto bg-white min-h-screen shadow-lg">
<!-- Header -->
<div class="bg-green-600 text-white p-4 flex items-center justify-between">
<a href="archivio.html" class="text-2xl">‹</a>
<h1 class="font-bold">Dettaglio</h1>
<button onclick="condividi()" class="text-xl">↗️</button>
</div>
<!-- Immagine -->
<div class="relative">
<img id="img" class="w-full h-64 object-cover bg-gray-200">
<span id="badge" class="absolute top-4 left-4 px-3 py-1 rounded-full text-sm font-bold bg-white shadow"></span>
</div>
<!-- Info -->
<div class="p-6 space-y-4">
<div>
<p class="text-sm text-gray-500 uppercase tracking-wide">Ente / Azienda</p>
<h2 id="ente" class="text-2xl font-bold text-gray-800"></h2>
</div>
<div class="grid grid-cols-2 gap-4">
<div class="bg-green-50 p-4 rounded-xl">
<p class="text-sm text-green-600">Importo</p>
<p id="importo" class="text-2xl font-bold text-green-700"></p>
</div>
<div class="bg-blue-50 p-4 rounded-xl">
<p class="text-sm text-blue-600">Tipo</p>
<p id="tipo" class="text-lg font-bold text-blue-700"></p>
</div>
</div>
<div class="bg-gray-50 p-4 rounded-xl">
<div class="flex justify-between items-center mb-2">
<p class="text-sm text-gray-500">Data scadenza</p>
<span id="badge-scadenza" class="text-xs px-2 py-1 rounded-full font-bold"></span>
</div>
<p id="scadenza" class="text-xl font-bold text-gray-800"></p>
<p id="giorni-rimasti" class="text-sm mt-1"></p>
</div>
<!-- Azioni -->
<div class="space-y-3 pt-4">
<a id="download" class="block w-full bg-green-600 text-white text-center py-4 rounded-xl font-bold hover:bg-green-700">
                   ⬇️ Scarica documento
</a>
<button onclick="elimina()" class="block w-full bg-red-100 text-red-600 text-center py-3 rounded-xl font-bold">
                   🗑️ Elimina
</button>
</div>
</div>
</div>
<script>
       const id = new URLSearchParams(location.search).get('id');
       const tel = localStorage.getItem('doctel');
       if(!id) location.href = 'archivio.html';
       // DATO FINTO PER TEST
       const doc = {
           id: id,
           entity_name: 'ENEL Energia SpA',
           document_type: 'Bolletta',
           amount: '124.50',
           due_date: '2025-04-15',
           category: 'utenze',
           file_url: 'https://via.placeholder.com/400x600/f0f0f0/666?text=Documento+' + id
       };
       function mostraDocumento(d) {
           document.getElementById('img').src = d.file_url;
           document.getElementById('ente').textContent = d.entity_name;
           document.getElementById('tipo').textContent = d.document_type;
           document.getElementById('importo').textContent = '€' + d.amount;
           document.getElementById('scadenza').textContent = new Date(d.due_date).toLocaleDateString('it-IT', {
               weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
           });
           document.getElementById('download').href = d.file_url;
           // Badge categoria
           const badge = document.getElementById('badge');
           badge.textContent = d.category;
           badge.className = 'absolute top-4 left-4 px-3 py-1 rounded-full text-sm font-bold shadow ' +
               (d.category === 'utenze' ? 'bg-yellow-100 text-yellow-800' :
                d.category === 'fattura' ? 'bg-blue-100 text-blue-800' :
                'bg-gray-100 text-gray-800');
           // Calcolo scadenza
           const giorni = Math.ceil((new Date(d.due_date) - new Date()) / (1000*60*60*24));
           const badgeScad = document.getElementById('badge-scadenza');
           const giorniText = document.getElementById('giorni-rimasti');
           if(giorni < 0) {
               badgeScad.textContent = 'SCADUTO';
               badgeScad.className = 'text-xs px-2 py-1 rounded-full font-bold bg-red-100 text-red-600';
               giorniText.textContent = 'Scaduto da ' + Math.abs(giorni) + ' giorni';
               giorniText.className = 'text-sm mt-1 text-red-600';
           } else if(giorni === 0) {
               badgeScad.textContent = 'OGGI';
               badgeScad.className = 'text-xs px-2 py-1 rounded-full font-bold bg-red-100 text-red-600';
               giorniText.textContent = 'Scade oggi!';
               giorniText.className = 'text-sm mt-1 text-red-600 font-bold';
           } else {
               badgeScad.textContent = giorni <= 7 ? 'URGENTE' : 'ATTIVO';
               badgeScad.className = 'text-xs px-2 py-1 rounded-full font-bold ' +
                   (giorni <= 7 ? 'bg-orange-100 text-orange-600' : 'bg-green-100 text-green-600');
               giorniText.textContent = 'Mancano ' + giorni + ' giorni';
               giorniText.className = 'text-sm mt-1 text-gray-600';
           }
           document.getElementById('loading').classList.add('hidden');
           document.getElementById('content').classList.remove('hidden');
       }
       mostraDocumento(doc);
       // Quando hai n8n:
       // fetch('https://TUO-N8N.com/webhook/doc?id=' + id)
       //     .then(r => r.json())
       //     .then(mostraDocumento);
       function condividi() {
           if(navigator.share) {
               navigator.share({
                   title: 'Documento ' + doc.entity_name,
                   text: 'Scadenza: ' + doc.due_date,
                   url: location.href
               });
           } else {
               alert('Link copiato!');
           }
       }
       function elimina() {
           if(confirm('Eliminare questo documento?')) {
               alert('Eliminato! (demo)');
               location.href = 'archivio.html';
           }
       }
</script>
</body>
</html>
